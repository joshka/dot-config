---
type Entry = { name: string; dir?: boolean; state?: "moved" | "new"; children?: Entry[] };
interface Props { entries: Entry[] }
const { entries: unsorted } = Astro.props;
// GitHub's file list order: folders first, then files, each alphabetical.
const entries = [...unsorted].sort(
  (a, b) => Number(!!b.dir) - Number(!!a.dir) || a.name.localeCompare(b.name, "en", { sensitivity: "base" }),
);
---

<ul>
  {
    entries.map((e) => (
      <li class={e.state}>
        <span class="row">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            {e.dir ? (
              <path d="M3 7V5.5A1.5 1.5 0 0 1 4.5 4H9l2 2.5h8.5A1.5 1.5 0 0 1 21 8v10.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5Z" />
            ) : (
              <>
                <path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8Z" />
                <path d="M14 3v5h5" />
              </>
            )}
          </svg>
          {e.name}
        </span>
        {e.children && <Astro.self entries={e.children} />}
      </li>
    ))
  }
</ul>
